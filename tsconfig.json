{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true, "types": ["node", "vite/client"],
    "esModuleInterop": true, "isolatedModules": true, "baseUrl": ".", "paths": { "@core/*": ["src/core/*"] }
  },
  "include": ["src", "web/src", "test", "scripts"]
}
