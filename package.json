{
  "name": "skillscope",
  "version": "0.1.0",
  "description": "Lint agent skills, plugins and MCP configs for prompt injection, context bloat and broken frontmatter. Animated live report with auto-fix suggestions.",
  "type": "module",
  "license": "MIT",
  "author": "Or Delevski",
  "repository": { "type": "git", "url": "git+https://github.com/delevski/skillscope.git" },
  "homepage": "https://delevski.github.io/skillscope/",
  "keywords": ["agent-skills", "claude-code", "mcp", "linter", "prompt-injection", "SKILL.md", "security"],
  "bin": { "skillscope": "dist/cli.mjs" },
  "files": ["dist/cli.mjs", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "vite",
    "build:cli": "esbuild src/cli/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/cli.mjs --banner:js=\"#!/usr/bin/env node\"",
    "build:web": "vite build",
    "build": "npm run build:cli && npm run build:web",
    "examples": "tsx scripts/write-examples.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
